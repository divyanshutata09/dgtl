# ============================================================================
# DGTL version 3.1.0  |  spirv_core.dgtl_isel  (Khronos SPIR-V Compute / GPU)
# Architecture:  SPIR-V Logical / Physical OpenCL / Vulkan Compute
# ============================================================================

include "common_runtime_forms.dgtl_isel"
include "core_base.dgtl_isel"

# ----------------------------------------------------------------------------
# SPIR-V FUSED VECTOR & PEEPHOLE RULES
# ----------------------------------------------------------------------------

rule spirv_fma_f32:        AddF32(MulF32($a, $b), $c) -> FMA_F32($a, $b, $c) [targets=spirv|vulkan|opencl, benefit=100]
rule spirv_fma_f32_rev:    AddF32($c, MulF32($a, $b)) -> FMA_F32($a, $b, $c) [targets=spirv|vulkan|opencl, benefit=100]
rule spirv_fma_f64:        AddF64(MulF64($a, $b), $c) -> FMA_F32($a, $b, $c) [targets=spirv|vulkan|opencl, benefit=100]

form fma_f32:             opcode=FMA_F32,               machine_form=FloatTernaryFma32