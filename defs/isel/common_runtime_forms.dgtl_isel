# ============================================================================
# DGTL (Deep General-purpose Transformation Layer) version 2.2.0
# COMPONENT: common_runtime_forms.dgtl_isel (Canonical Runtime Dispatches)
# ARCHITECTURE: Target-Independent (Shared across x64, ARM64, WASM, RISC-V)
# SYNCHRONIZATION: 100% Full Parity with phase1_core_ops.dgtl_def & IRBuilder
# ============================================================================

# ----------------------------------------------------------------------------
# 1. STRING SUBSYSTEM & DESCRIPTORS
# ----------------------------------------------------------------------------

form string_length:               opcode=STRING_LENGTH,         machine_form=Call, semantic=StringLength
form string_compare:              opcode=STRING_COMPARE,        machine_form=Call, semantic=StringCompare
form string_concat:               opcode=STRING_CONCAT,         machine_form=Call, semantic=StringConcat
form string_substring:            opcode=STRING_SUBSTRING,      machine_form=Call, semantic=StringSubstring

# ----------------------------------------------------------------------------
# 2. DYNAMIC MEMORY, ARENA & SYSTEM INTRINSICS
# ----------------------------------------------------------------------------

form dsa_allocate:                opcode=DSA_ALLOCATE,          machine_form=Call
form dsa_deallocate:              opcode=DSA_DEALLOCATE,        machine_form=Call

# Dynamic Reference Lifetime & Ownership (DRLC)
form ownership_acquire:           opcode=OWNERSHIP_ACQUIRE,     machine_form=Call
form ownership_release:           opcode=OWNERSHIP_RELEASE,     machine_form=Call
form ownership_transfer:          opcode=OWNERSHIP_TRANSFER,    machine_form=Call

# ----------------------------------------------------------------------------
# 3. CONCURRENCY, CHANNELS, ASYNC & FIBERS
# ----------------------------------------------------------------------------

form async_launch:                opcode=ASYNC_LAUNCH,          machine_form=ConcurrentSync
form async_spawn:                 opcode=ASYNC_SPAWN,           machine_form=ConcurrentSync
form async_await:                 opcode=ASYNC_AWAIT,           machine_form=ConcurrentSync
form chan_send:                   opcode=CHAN_SEND,             machine_form=ConcurrentSync
form chan_recv:                   opcode=CHAN_RECV,             machine_form=ConcurrentSync
form barrier_sync:                opcode=BARRIER_SYNC,          machine_form=ConcurrentSync
form sync_barrier:                opcode=SYNC_BARRIER,          machine_form=ConcurrentSync
form thread_spawn:                opcode=THREAD_SPAWN,          machine_form=ConcurrentSync
form fiber_yield:                 opcode=FIBER_YIELD,           machine_form=ConcurrentSync
form fiber_yield_loop:            opcode=FIBER_YIELD_LOOP,      machine_form=ConcurrentSync
form suspend_ctx:                 opcode=SUSPEND_CTX,           machine_form=Call
form resume_ctx:                  opcode=RESUME_CTX,            machine_form=Call
form deopt_trigger:               opcode=DEOPT_TRIGGER,         machine_form=Call
form lock_acquire:                opcode=LOCK_ACQUIRE,          machine_form=ConcurrentSync
form lock_release:                opcode=LOCK_RELEASE,          machine_form=ConcurrentSync
form ring_push_free:              opcode=RING_PUSH_FREE,        machine_form=Call
form wasm_invoke:                 opcode=WASM_INVOKE,           machine_form=Call

# ----------------------------------------------------------------------------
# 4. TENSORS, AI/ML, NEURAL LAYERS & SPATIAL MATH
# ----------------------------------------------------------------------------

form matmul_bf16:                 opcode=MATMUL_BF16,           machine_form=TensorOp
form matmul_fp8:                  opcode=MATMUL_FP8,            machine_form=TensorOp
form sdpa_f16:                    opcode=SDPA_F16,              machine_form=TensorOp
form softmax_fast:                opcode=SOFTMAX_FAST,          machine_form=TensorOp
form layer_norm:                  opcode=LAYER_NORM,            machine_form=TensorOp
form rope_embed:                  opcode=ROPE_EMBED,            machine_form=TensorOp

form vec3_cross:                  opcode=VEC3_CROSS,            machine_form=Call
form vec4_dot:                    opcode=VEC4_DOT,              machine_form=Call
form mat4_mul:                    opcode=MAT4_MUL,              machine_form=Call
form quat_slerp:                  opcode=QUAT_SLERP,            machine_form=Call
form ray_aabb_isect:              opcode=RAY_AABB_ISECT,        machine_form=Call

form fcvtl_f16_to_f32:            opcode=FCVTL_F16_TO_F32,      machine_form=Call
form fcvtn_f32_to_f16:            opcode=FCVTN_F32_TO_F16,      machine_form=Call
form fma_widen_f16_f32:           opcode=FMA_WIDEN_F16_F32,     machine_form=Call

form tensor_broadcast:            opcode=TENSOR_BROADCAST,      machine_form=TensorOp
form tensor_concat:               opcode=TENSOR_CONCAT,         machine_form=TensorOp
form tensor_conv:                 opcode=TENSOR_CONV,           machine_form=TensorOp
form tensor_gemm:                 opcode=TENSOR_GEMM,           machine_form=TensorOp
form tensor_pool:                 opcode=TENSOR_POOL,           machine_form=TensorOp
form tensor_reduce:               opcode=TENSOR_REDUCE,         machine_form=TensorOp
form tensor_reshape:              opcode=TENSOR_RESHAPE,        machine_form=TensorOp
form tensor_slice:                opcode=TENSOR_SLICE,          machine_form=TensorOp
form tensor_softmax:              opcode=TENSOR_SOFTMAX,        machine_form=TensorOp
form tensor_transpose:            opcode=TENSOR_TRANSPOSE,      machine_form=TensorOp

# ----------------------------------------------------------------------------
# 5. DATA STRUCTURES & EXTENDED SYNTAX INTERNALS
# ----------------------------------------------------------------------------

form graph_build:                 opcode=GRAPH_BUILD,           machine_form=Call
form graph_traverse:              opcode=GRAPH_TRAVERSE,        machine_form=Call
form tree_build:                  opcode=TREE_BUILD,            machine_form=Call
form tree_traverse:               opcode=TREE_TRAVERSE,         machine_form=Call
form trie_build:                  opcode=TRIE_BUILD,            machine_form=Call
form trie_insert:                 opcode=TRIE_INSERT,           machine_form=Call
form trie_lookup:                 opcode=TRIE_LOOKUP,           machine_form=Call
form tuple_pack:                  opcode=TUPLE_PACK,            machine_form=Call
form tuple_unpack:                opcode=TUPLE_UNPACK,          machine_form=Call

form vec_load:                    opcode=VEC_LOAD,              machine_form=Call
form vec_reduce_add:              opcode=VEC_REDUCE_ADD,        machine_form=Call
form vec_shuffle:                 opcode=VEC_SHUFFLE,           machine_form=Call
form vec_store:                   opcode=VEC_STORE,             machine_form=Call
form simd_bsl_predicate:          opcode=SIMD_BSL_PREDICATE,    machine_form=Call
form switch_dispatch:             opcode=SWITCH_DISPATCH,       machine_form=Call
form bit_field_insert:            opcode=BIT_FIELD_INSERT,      machine_form=Call
form bit_field_extract:           opcode=BIT_FIELD_EXTRACT,     machine_form=Call
form phi_node:                    opcode=PHI_NODE,              machine_form=Call
form phi_multi:                   opcode=PHI_MULTI,             machine_form=Call
form select_multi:                opcode=SELECT_MULTI,          machine_form=Call
form gpu_launch:                  opcode=GPU_LAUNCH,            machine_form=Call
form atomic_snapshot:             opcode=ATOMIC_SNAPSHOT,       machine_form=AtomicOp
form guard_alias:                 opcode=GUARD_ALIAS,           machine_form=Call
form guard_value:                 opcode=GUARD_VALUE,           machine_form=Call
form scop_analyze:                opcode=SCOP_ANALYZE,          machine_form=Call


# Explicitly unhandled canonical operations.
# These are intentional coverage declarations, not implicit generator defaults.
form unhandled_cpp_template_spec: opcode=CPP_TEMPLATE_SPEC, machine_form=Unhandled
form unhandled_dgtl_fast_add: opcode=DGTL_FAST_ADD, machine_form=Unhandled
form unhandled_dgtl_fast_fma: opcode=DGTL_FAST_FMA, machine_form=Unhandled
form unhandled_gpu_annotate_device: opcode=GPU_ANNOTATE_DEVICE, machine_form=Unhandled
form unhandled_gpu_barrier: opcode=GPU_BARRIER, machine_form=Unhandled
form unhandled_gpu_kernel_fuse: opcode=GPU_KERNEL_FUSE, machine_form=Unhandled
form unhandled_gpu_mem_transfer: opcode=GPU_MEM_TRANSFER, machine_form=Unhandled
form unhandled_gpu_sync_point: opcode=GPU_SYNC_POINT, machine_form=Unhandled
form unhandled_rust_borrow_mut: opcode=RUST_BORROW_MUT, machine_form=Unhandled
form unhandled_simd_complex_fma: opcode=SIMD_COMPLEX_FMA, machine_form=Unhandled
form unhandled_simd_interleaved_load: opcode=SIMD_INTERLEAVED_LOAD, machine_form=Unhandled
form unhandled_simd_masked_store: opcode=SIMD_MASKED_STORE, machine_form=Unhandled
form unhandled_simd_reduce_max: opcode=SIMD_REDUCE_MAX, machine_form=Unhandled
form unhandled_simd_reduce_min: opcode=SIMD_REDUCE_MIN, machine_form=Unhandled
form unhandled_simd_scatter_indirect: opcode=SIMD_SCATTER_INDIRECT, machine_form=Unhandled
form unhandled_tensor_batchnorm: opcode=TENSOR_BATCHNORM, machine_form=Unhandled
form unhandled_tensor_gather: opcode=TENSOR_GATHER, machine_form=Unhandled
form unhandled_tensor_relu: opcode=TENSOR_RELU, machine_form=Unhandled
form unhandled_tensor_scatter_d: opcode=TENSOR_SCATTER_D, machine_form=Unhandled
