#@ version: 2.0
#@ namespace: dgtl::ir
#@ generated_by: tools/cpp/dgtl_gen_main.cpp
#@ architecture: Unified Compute IR (HFT, AI, Game Engine, Cloud, Mobile)
#@ canonical_source: true
#@ opcode_values: explicit
#@ opcode_width: 16
#@ generated_outputs: DGTL_Gen_Enums.ixx,DGTL_Gen_Ops.ixx,DGTL_Gen_Op_Wrappers.ixx
#@ stable_abi: preserve_existing_values
#@ dialect_ranges: reserved_namespace_not_required_for_existing_stable_ids
#@ alias_surface: explicit
#@ alias_source: aliases

# ============================================================================
# SECTION 1: TYPE DEFINITIONS
# ============================================================================

[types]
type Bool: builtin, width=1
type Predicate: builtin, width=1
type AddressSpace: builtin, width=32
type Ptr: pointer, pointee=I64, address_space=generic
type StringHandle: builtin, width=64
type I4: builtin, width=4
type I8: builtin, width=8
type I16: builtin, width=16
type I32: builtin, width=32
type I64: builtin, width=64
type I128: builtin, width=128
type I256: builtin, width=256
type I512: builtin, width=512
type F8: builtin, width=8
type BF16: builtin, width=16
type F16: builtin, width=16
type F32: builtin, width=32
type F64: builtin, width=64
type F128: builtin, width=128
type Vec3xF32: vector, element_type=F32, width=96
type Vec4xF32: vector, element_type=F32, width=128
type Mat4x4F32: vector, element_type=F32, width=512
type QuatF32: vector, element_type=F32, width=128
type VectorF32x16: vector, element_type=F32, width=512
type VectorI32x16: vector, element_type=I32, width=512
type VectorF16x32: vector, element_type=F16, width=512
type TensorFP8: tensor, element_type=F8
type TensorBF16: tensor, element_type=BF16
type TensorF32: tensor, element_type=F32
type TensorI64: tensor, element_type=I64

# ============================================================================
# SECTION 2: TRAIT DEFINITIONS
# ============================================================================

[traits]
trait Commutative: "Binary operations with commutative operands"
trait HasNoSideEffects: "Operation has no observable side effects"
trait IsTerminator: "Control flow terminator (branch, return, etc.)"
trait IsMemoryRead: "Reads from memory"
trait IsMemoryWrite: "Writes to memory"
trait IsMemoryOp: "Generic memory operation"
trait IsVectorizable: "Can be vectorized by SIMD passes"
trait IsFusible: "Can be fused with other operations"
trait IsSpeculative: "May trigger deoptimization"
trait IsGuard: "Guards against speculative assumptions"
trait IsGPU: "GPU-specific operation"
trait IsTensor: "Tensor/ML operation"
trait IsGraph: "Graph data structure operation"
trait IsAsyncSpawnable: "Can be spawned asynchronously"
trait IsLatencyCritical: "HFT: Must bypass standard scheduling for nanosecond latency"
trait IsHardwareIntrinsic: "Maps directly to a physical CPU/GPU instruction"
trait Associative: "Operation is associative under the IR semantic domain"
trait ConstantFoldable: "Operation has a defined compile-time constant folding semantics"
trait MemoryBarrier: "Operation prevents unsafe memory reordering"
trait SingleDefUse: "Operation participates in DGTL single-definition/use verification"

# ============================================================================
# SECTION 3: INTERFACE DEFINITIONS
# ============================================================================

[interfaces]
interface Arithmetic: "Binary arithmetic operations (add, sub, mul, div)"
interface Memory: "Memory operations (load, store, prefetch)"
interface ControlFlow: "Control flow operations"
interface Terminator: "Terminating operations (return, branch)"
interface Comparison: "Comparison operations"
interface BitwiseOp: "Bitwise operations"
interface SIMD: "SIMD vector operations"
interface GPU: "GPU-specific operations"
interface Tensor: "Tensor/ML operations"
interface Concurrency: "Concurrency primitives (spawn, barrier, lock)"
interface DSA: "Data structure operations (graph, tree, trie)"
interface Ownership: "Ownership and memory safety operations"
interface PointerMath: "Pointer arithmetic and memory addressing"
interface NeuralNet: "AI Neural Network primitives (Attention, Norms)"
interface SpatialMath: "Game Engine spatial mathematics (Quaternions, Matrices)"

# ============================================================================
# SECTION 3B: ATTRIBUTE DEFINITIONS
# ============================================================================

[attributes]
attribute NoWrap: "Arithmetic does not wrap on overflow"
attribute Exact: "Semantics require exact (non-approximate) result"
attribute FastMath: "Floating point operation permits fast-math transforms"
attribute Aligned: "Memory operand is guaranteed aligned"
attribute NoAlias: "Memory operand is proven no-alias"
attribute AddrSpaceGeneric: "Pointer operand is in generic address space"
attribute Predicated: "Operation requires canonical predicate semantics"
attribute Relaxed: "Atomic operation has relaxed ordering"
attribute Acquire: "Atomic operation has acquire ordering"
attribute Release: "Atomic operation has release ordering"
attribute SeqCst: "Atomic operation has sequential consistency"
attribute HotPath: "HFT: Branch predictor hint (Likely)"
attribute ColdPath: "HFT: Branch predictor hint (Unlikely)"
attribute LockFree: "Algorithm guarantees lock-free execution"
attribute Variadic: "Operation accepts a variable number of operands or produces a variable number of results"
attribute MultiResult: "Operation produces multiple SSA results"

# ============================================================================
# SECTION 4: DIALECT DEFINITIONS
# ============================================================================

[dialects]
# Contract: dialect opcode ranges must be pairwise disjoint.
# Generator/runtime validation should fail if ranges overlap.
dialect core: namespace=dgtl::ir::core, opcode_range=[0, 0x2FF]
dialect simd: namespace=dgtl::ir::simd, opcode_range=[0x500, 0x5FF]
dialect gpu: namespace=dgtl::ir::gpu, opcode_range=[0x400, 0x40F]
dialect concurrency: namespace=dgtl::ir::concurrency, opcode_range=[0x410, 0x42F]
dialect dsa: namespace=dgtl::ir::dsa, opcode_range=[0x440, 0x45F]
dialect tensor: namespace=dgtl::ir::tensor, opcode_range=[0x460, 0x47F]
dialect ai: namespace=dgtl::ir::ai, opcode_range=[0x480, 0x4FF]
dialect hft: namespace=dgtl::ir::hft, opcode_range=[0x600, 0x6FF]
dialect game: namespace=dgtl::ir::game, opcode_range=[0x700, 0x7FF]
dialect custom: namespace=dgtl::ir::custom, opcode_range=[0x8000, 0xFFFF]

# ============================================================================
# SECTION 5: CORE OPERATIONS
# ============================================================================

[operations:core]

# ---- Special ----
op Nop: opcode=NOP, value=0x0, operands=0, result=void, traits=HasNoSideEffects, interfaces=, description="No operation"
op Undef: opcode=UNDEF, value=0x59, operands=0, result=I64, traits=HasNoSideEffects, interfaces=, description="Undefined value"

# ---- Memory Operations ----
op Load: opcode=LOAD, value=0xA, operands=1, result=I64, traits=IsMemoryRead|MemoryBarrier|SingleDefUse, interfaces=Memory, description="Load from memory"
op Store: opcode=STORE, value=0xB, operands=2, result=void, traits=IsMemoryWrite|MemoryBarrier, interfaces=Memory, description="Store to memory"
op AtomicLoad: opcode=ATOMIC_LOAD, value=0x10, operands=1, result=I64, traits=IsMemoryRead|MemoryBarrier|SingleDefUse, interfaces=Memory, attributes=Acquire|AddrSpaceGeneric, description="Atomic load with acquire semantics"
op AtomicStore: opcode=ATOMIC_STORE, value=0x11, operands=2, result=void, traits=IsMemoryWrite|MemoryBarrier, interfaces=Memory, attributes=Release|AddrSpaceGeneric, description="Atomic store with release semantics"
op AtomicFence: opcode=ATOMIC_FENCE, value=0x12, operands=0, result=void, traits=IsMemoryOp|MemoryBarrier, interfaces=Memory, attributes=SeqCst, description="Atomic fence"
op PtrCast: opcode=PTR_CAST, value=0x51, operands=1, result=I64, traits=HasNoSideEffects|SingleDefUse, interfaces=, attributes=NoAlias|AddrSpaceGeneric, description="Pointer cast"
op PtrDiff: opcode=PTR_DIFF, value=0x52, operands=2, result=I64, traits=HasNoSideEffects|SingleDefUse, interfaces=, attributes=NoAlias|AddrSpaceGeneric, description="Pointer difference"
op GetElementPtr: opcode=GEP, value=0x5A, operands=2, result=Ptr, traits=HasNoSideEffects, interfaces=PointerMath, description="Address computation (GEP)"
op PtrToInt: opcode=PTR_TO_INT, value=0x5B, operands=1, result=I64, traits=HasNoSideEffects, interfaces=PointerMath, description="Cast pointer to integer"
op IntToPtr: opcode=INT_TO_PTR, value=0x5C, operands=1, result=Ptr, traits=HasNoSideEffects, interfaces=PointerMath, description="Cast integer to pointer"
op BoolSelect: opcode=BOOL_SELECT, value=0x53, operands=3, result=I64, traits=HasNoSideEffects, interfaces=, attributes=Predicated, description="Select by predicate"
op RegMove: opcode=REG_MOVE, value=0xC, operands=1, result=I64, traits=HasNoSideEffects, interfaces=, description="Register move"
op LoadImm: opcode=LOAD_IMM, value=0xD, operands=0, result=I64, traits=HasNoSideEffects|SingleDefUse, interfaces=, description="Load immediate value"
op Lea: opcode=LEA, value=0xE, operands=1, result=I64, traits=HasNoSideEffects|SingleDefUse, interfaces=Memory, description="Load effective address"
op Prefetch: opcode=PREFETCH, value=0xF, operands=1, result=void, traits=HasNoSideEffects|IsMemoryRead, interfaces=Memory, description="Memory prefetch hint"
op Immediate: opcode=IMMEDIATE, value=0x50, operands=0, result=I64, traits=HasNoSideEffects|SingleDefUse, interfaces=, description="Folded constant node"
op StringConst: opcode=STRING_CONST, value=0x54, operands=1, result=StringHandle, traits=HasNoSideEffects|SingleDefUse, interfaces=, description="Interned string-handle literal"
op StringLength: opcode=STRING_LENGTH, value=0x55, operands=1, result=I64, traits=HasNoSideEffects, interfaces=, description="String length from handle"
op StringCompare: opcode=STRING_COMPARE, value=0x56, operands=2, result=I32, traits=HasNoSideEffects, interfaces=Comparison, description="Lexical string comparison"
op StringConcat: opcode=STRING_CONCAT, value=0x57, operands=2, result=StringHandle, traits=HasNoSideEffects, interfaces=, description="Concatenate two string handles"
op StringSubstring: opcode=STRING_SUBSTRING, value=0x58, operands=3, result=StringHandle, traits=HasNoSideEffects, interfaces=, description="Substring from handle, start, and length"

# ---- Integer 32-bit ----
op AddI8: opcode=ADD_I8, value=0x13, operands=2, result=I8, traits=Commutative|HasNoSideEffects, interfaces=Arithmetic, description="8-bit integer addition"
op AddI32: opcode=ADD_I32, value=0x14, operands=2, result=I32, traits=Commutative|HasNoSideEffects|ConstantFoldable|Associative, interfaces=Arithmetic, description="32-bit integer addition"
op SubI32: opcode=SUB_I32, value=0x15, operands=2, result=I32, traits=HasNoSideEffects|ConstantFoldable, interfaces=Arithmetic, description="32-bit integer subtraction"
op MulI32: opcode=MUL_I32, value=0x16, operands=2, result=I32, traits=Commutative|HasNoSideEffects|ConstantFoldable|Associative, interfaces=Arithmetic, description="32-bit integer multiplication"
op DivI32: opcode=DIV_I32, value=0x17, operands=2, result=I32, traits=HasNoSideEffects|ConstantFoldable, interfaces=Arithmetic, description="32-bit integer division"
op ShlI32: opcode=SHL_I32, value=0x18, operands=2, result=I32, traits=HasNoSideEffects|ConstantFoldable, interfaces=BitwiseOp, description="32-bit shift left"
op AndI32: opcode=AND_I32, value=0x19, operands=2, result=I32, traits=Commutative|HasNoSideEffects|ConstantFoldable|Associative, interfaces=BitwiseOp, description="32-bit bitwise AND"
op OrI32: opcode=OR_I32, value=0x1A, operands=2, result=I32, traits=Commutative|HasNoSideEffects|ConstantFoldable|Associative, interfaces=BitwiseOp, description="32-bit bitwise OR"
op XorI32: opcode=XOR_I32, value=0x1B, operands=2, result=I32, traits=Commutative|HasNoSideEffects|ConstantFoldable|Associative, interfaces=BitwiseOp, description="32-bit bitwise XOR"
op ModI32: opcode=MOD_I32, value=0x1C, operands=2, result=I32, traits=HasNoSideEffects|ConstantFoldable, interfaces=Arithmetic, description="32-bit integer modulo"
op ShrI32: opcode=SHR_I32, value=0x1D, operands=2, result=I32, traits=HasNoSideEffects|ConstantFoldable, interfaces=BitwiseOp, description="32-bit shift right"

# ---- Integer 64-bit ----
op AddI64: opcode=ADD_I64, value=0x3C, operands=2, result=I64, traits=Commutative|HasNoSideEffects|ConstantFoldable|Associative, interfaces=Arithmetic, description="64-bit integer addition"
op SubI64: opcode=SUB_I64, value=0x3D, operands=2, result=I64, traits=HasNoSideEffects|ConstantFoldable, interfaces=Arithmetic, description="64-bit integer subtraction"
op MulI64: opcode=MUL_I64, value=0x3E, operands=2, result=I64, traits=Commutative|HasNoSideEffects|ConstantFoldable|Associative, interfaces=Arithmetic, description="64-bit integer multiplication"
op DivI64: opcode=DIV_I64, value=0x3F, operands=2, result=I64, traits=HasNoSideEffects|ConstantFoldable, interfaces=Arithmetic, description="64-bit integer division"
op ModI64: opcode=MOD_I64, value=0x40, operands=2, result=I64, traits=HasNoSideEffects|ConstantFoldable, interfaces=Arithmetic, description="64-bit integer modulo"
op AddI128: opcode=ADD_I128, value=0x82, operands=2, result=I128, traits=Commutative|HasNoSideEffects, interfaces=Arithmetic, description="128-bit integer addition"
op AddI256: opcode=ADD_I256, value=0x83, operands=2, result=I256, traits=Commutative|HasNoSideEffects, interfaces=Arithmetic, description="256-bit integer addition"

# ---- Floating Point 32-bit ----
op AddF8: opcode=ADD_F8, value=0x84, operands=2, result=F8, traits=Commutative|HasNoSideEffects, interfaces=Arithmetic, description="FP8 addition (AI)"
op AddBF16: opcode=ADD_BF16, value=0x85, operands=2, result=BF16, traits=Commutative|HasNoSideEffects, interfaces=Arithmetic, description="BFloat16 addition (AI)"
op AddF32: opcode=ADD_F32, value=0x1E, operands=2, result=F32, traits=Commutative|HasNoSideEffects, interfaces=Arithmetic, description="32-bit float addition"
op SubF32: opcode=SUB_F32, value=0x1F, operands=2, result=F32, traits=HasNoSideEffects, interfaces=Arithmetic, description="32-bit float subtraction"
op MulF32: opcode=MUL_F32, value=0x20, operands=2, result=F32, traits=Commutative|HasNoSideEffects, interfaces=Arithmetic, description="32-bit float multiplication"
op DivF32: opcode=DIV_F32, value=0x21, operands=2, result=F32, traits=HasNoSideEffects, interfaces=Arithmetic, description="32-bit float division"
op FmaF32: opcode=FMA_F32, value=0x23, operands=3, result=F32, traits=HasNoSideEffects, interfaces=Arithmetic, description="32-bit fused multiply-add"
op FmaWidenF16F32: opcode=FMA_WIDEN_F16_F32, value=0x24, operands=2, result=F32, traits=HasNoSideEffects, interfaces=SIMD, description="Fused multiply-add with F16 to F32 widening"

# ---- Floating Point 64-bit ----
op AddF64: opcode=ADD_F64, value=0x46, operands=2, result=F64, traits=Commutative|HasNoSideEffects, interfaces=Arithmetic, description="64-bit float addition"
op SubF64: opcode=SUB_F64, value=0x47, operands=2, result=F64, traits=HasNoSideEffects, interfaces=Arithmetic, description="64-bit float subtraction"
op MulF64: opcode=MUL_F64, value=0x48, operands=2, result=F64, traits=Commutative|HasNoSideEffects, interfaces=Arithmetic, description="64-bit float multiplication"
op DivF64: opcode=DIV_F64, value=0x49, operands=2, result=F64, traits=HasNoSideEffects, interfaces=Arithmetic, description="64-bit float division"

# ---- Comparison (32-bit) ----
op CmpEqI32: opcode=CMP_EQ_I32, value=0x28, operands=2, result=I32, traits=Commutative|HasNoSideEffects, interfaces=Comparison, description="32-bit integer equality comparison"
op CmpNeI32: opcode=CMP_NE_I32, value=0x29, operands=2, result=I32, traits=Commutative|HasNoSideEffects, interfaces=Comparison, description="32-bit integer not-equal comparison"
op CmpLtI32: opcode=CMP_LT_I32, value=0x2A, operands=2, result=I32, traits=HasNoSideEffects, interfaces=Comparison, description="32-bit integer less-than comparison"
op CmpLeI32: opcode=CMP_LE_I32, value=0x2B, operands=2, result=I32, traits=HasNoSideEffects, interfaces=Comparison, description="32-bit integer less-equal comparison"
op CmpGtI32: opcode=CMP_GT_I32, value=0x2C, operands=2, result=I32, traits=HasNoSideEffects, interfaces=Comparison, description="32-bit integer greater-than comparison"
op CmpGeI32: opcode=CMP_GE_I32, value=0x2D, operands=2, result=I32, traits=HasNoSideEffects, interfaces=Comparison, description="32-bit integer greater-equal comparison"

# ---- Bitfield Operations ----
op BitFieldInsert: opcode=BIT_FIELD_INSERT, value=0x32, operands=3, result=I64, traits=HasNoSideEffects|ConstantFoldable, interfaces=BitwiseOp, description="Insert bitfield into value"
op BitFieldExtract: opcode=BIT_FIELD_EXTRACT, value=0x33, operands=3, result=I64, traits=HasNoSideEffects|ConstantFoldable, interfaces=BitwiseOp, description="Extract bitfield from value"

# ---- Control Flow ----
op Label: opcode=LABEL, value=0x62, operands=0, result=void, traits=HasNoSideEffects, interfaces=ControlFlow, description="Basic block label"
op Goto: opcode=GOTO, value=0x63, operands=0, result=void, traits=IsTerminator, interfaces=ControlFlow|Terminator, description="Unconditional branch"
op Branch: opcode=BRANCH, value=0x64, operands=1, result=void, traits=IsTerminator, interfaces=ControlFlow|Terminator, description="Unconditional branch to successor"
op BranchCond: opcode=BRANCH_COND, value=0x66, operands=3, result=void, traits=IsTerminator, interfaces=ControlFlow|Terminator, description="Conditional branch"
op BranchCompareFused: opcode=BRANCH_COMPARE_FUSED, value=0x67, operands=4, result=void, traits=IsTerminator, interfaces=ControlFlow|Terminator, description="Fused compare and branch"
op Call: opcode=CALL, value=0x6E, operands=1, result=I64, traits=IsSpeculative|MemoryBarrier, interfaces=ControlFlow, description="Function call"
op Syscall: opcode=SYSCALL, value=0x6F, operands=1, result=I64, traits=, interfaces=ControlFlow, description="System call"
op GuardAlias: opcode=GUARD_ALIAS, value=0x78, operands=2, result=void, traits=IsGuard, interfaces=ControlFlow, description="Alias analysis guard"
op Return: opcode=RET, value=0x65, operands=1, result=void, traits=IsTerminator, interfaces=ControlFlow|Terminator, description="Return from function"

# ---- SSA / IR ----
op PhiNode: opcode=PHI_NODE, value=0xCA, operands=2, result=I64, traits=HasNoSideEffects, interfaces=, description="Phi node for SSA"
op Select: opcode=SELECT, value=0xCC, operands=3, result=I64, traits=HasNoSideEffects, interfaces=ControlFlow, description="Ternary select (condition ? a : b)"

# ---- Speculation ----
op GuardValue: opcode=GUARD_VALUE, value=0xC8, operands=1, result=I64, traits=IsGuard|IsSpeculative, interfaces=, description="Guard against value assumption"
op DeoptTrigger: opcode=DEOPT_TRIGGER, value=0xC9, operands=1, result=void, traits=IsSpeculative, interfaces=, description="Trigger deoptimization"
op Assume: opcode=ASSUME, value=0xCB, operands=1, result=void, traits=HasNoSideEffects, interfaces=, description="Assume condition is true"

# ---- Region/Fusion ----
op RegionBegin: opcode=REGION_BEGIN, value=0x258, operands=0, result=void, traits=HasNoSideEffects, interfaces=, description="Region begin marker"
op RegionEnd: opcode=REGION_END, value=0x259, operands=0, result=void, traits=HasNoSideEffects, interfaces=, description="Region end marker"
op FusionGroup: opcode=FUSION_GROUP, value=0x25A, operands=0, result=void, traits=HasNoSideEffects, interfaces=, description="Fusion group marker"

# ============================================================================
# SECTION 6: SIMD OPERATIONS
# ============================================================================

[operations:simd]

op GatherF32x512: opcode=GATHER_F32_512, value=0x500, operands=1, result=VectorF32x16, traits=IsMemoryRead|IsVectorizable, interfaces=SIMD|Memory, description="Gather 16x F32 values into 512-bit vector"
op Gather16: opcode=GATHER_16, value=0x501, operands=1, result=VectorF32x16, traits=IsMemoryRead|IsVectorizable, interfaces=SIMD|Memory, description="Gather 16 values"
op StoreV512: opcode=STORE_V512, value=0x502, operands=2, result=void, traits=IsMemoryWrite|IsVectorizable|MemoryBarrier, interfaces=SIMD|Memory, description="Store 512-bit vector to memory"
op VecAddF32x512: opcode=VEC_ADD_F32_512, value=0x503, operands=2, result=VectorF32x16, traits=Commutative|HasNoSideEffects|IsVectorizable, interfaces=SIMD|Arithmetic, description="512-bit F32 vector addition"
op VecMulF32x512: opcode=VEC_MUL_F32_512, value=0x504, operands=2, result=VectorF32x16, traits=Commutative|HasNoSideEffects|IsVectorizable, interfaces=SIMD|Arithmetic, description="512-bit F32 vector multiplication"
op SimdBslPredicate: opcode=SIMD_BSL_PREDICATE, value=0x507, operands=3, result=VectorF32x16, traits=HasNoSideEffects, interfaces=SIMD, description="SIMD bitwise select with predicate"
op FcvtlF16ToF32: opcode=FCVTL_F16_TO_F32, value=0x508, operands=1, result=VectorF32x16, traits=HasNoSideEffects|IsVectorizable, interfaces=SIMD, description="Convert F16 vector to F32"
op FcvtnF32ToF16: opcode=FCVTN_F32_TO_F16, value=0x509, operands=1, result=VectorF16x32, traits=HasNoSideEffects|IsVectorizable, interfaces=SIMD, description="Convert F32 vector to F16"
op VecLoad: opcode=VEC_LOAD, value=0x510, operands=1, result=VectorF32x16, traits=IsMemoryRead|IsVectorizable, interfaces=SIMD|Memory, description="Vector load"
op VecStore: opcode=VEC_STORE, value=0x511, operands=2, result=void, traits=IsMemoryWrite|IsVectorizable, interfaces=SIMD|Memory, description="Vector store"
op VecShuffle: opcode=VEC_SHUFFLE, value=0x512, operands=2, result=VectorF32x16, traits=HasNoSideEffects|IsVectorizable, interfaces=SIMD, description="Vector shuffle"
op VecReduceAdd: opcode=VEC_REDUCE_ADD, value=0x513, operands=1, result=F32, traits=HasNoSideEffects|IsVectorizable, interfaces=SIMD|Arithmetic, description="Vector reduce-add"

# Advanced SIMD
op SimdReduceMax: opcode=SIMD_REDUCE_MAX, value=0x8010, operands=1, result=F32, traits=HasNoSideEffects|IsVectorizable, interfaces=SIMD|Arithmetic, description="SIMD reduce maximum"
op SimdReduceMin: opcode=SIMD_REDUCE_MIN, value=0x8011, operands=1, result=F32, traits=HasNoSideEffects|IsVectorizable, interfaces=SIMD|Arithmetic, description="SIMD reduce minimum"
op SimdScatterIndirect: opcode=SIMD_SCATTER_INDIRECT, value=0x8012, operands=3, result=void, traits=IsMemoryWrite|IsVectorizable, interfaces=SIMD|Memory, description="SIMD indirect scatter to memory"
op SimdMaskedStore: opcode=SIMD_MASKED_STORE, value=0x8013, operands=3, result=void, traits=IsMemoryWrite|IsVectorizable, interfaces=SIMD|Memory, description="SIMD masked store to memory"
op SimdInterleavedLoad: opcode=SIMD_INTERLEAVED_LOAD, value=0x8014, operands=1, result=VectorF32x16, traits=IsMemoryRead|IsVectorizable, interfaces=SIMD|Memory, description="SIMD interleaved load from memory"
op SimdComplexFma: opcode=SIMD_COMPLEX_FMA, value=0x8015, operands=3, result=VectorF32x16, traits=HasNoSideEffects|IsVectorizable, interfaces=SIMD|Arithmetic, description="SIMD complex fused multiply-add"

# ============================================================================
# SECTION 7: GPU OPERATIONS
# ============================================================================

[operations:gpu]

op GpuLaunch: opcode=GPU_LAUNCH, value=0x190, operands=1, result=void, traits=IsAsyncSpawnable, interfaces=GPU, description="Launch GPU kernel"
op OwnershipAcquire: opcode=OWNERSHIP_ACQUIRE, value=0x19A, operands=1, result=I64, traits=, interfaces=Ownership, description="Acquire ownership of value"
op OwnershipRelease: opcode=OWNERSHIP_RELEASE, value=0x19B, operands=1, result=void, traits=, interfaces=Ownership, description="Release ownership of value"
op OwnershipTransfer: opcode=OWNERSHIP_TRANSFER, value=0x19C, operands=2, result=I64, traits=, interfaces=Ownership, description="Transfer ownership (move semantics)"
op AtomicSnapshot: opcode=ATOMIC_SNAPSHOT, value=0x19D, operands=1, result=I64, traits=IsMemoryRead, interfaces=Ownership, description="Atomic capture of current value"

# GPU advanced
op GpuMemTransfer: opcode=GPU_MEM_TRANSFER, value=0x8020, operands=2, result=void, traits=IsMemoryRead|IsMemoryWrite, interfaces=GPU|Memory, description="GPU memory transfer"
op GpuBarrier: opcode=GPU_BARRIER, value=0x8021, operands=0, result=void, traits=, interfaces=GPU, description="GPU synchronization barrier"
op GpuSyncPoint: opcode=GPU_SYNC_POINT, value=0x8022, operands=0, result=void, traits=, interfaces=GPU, description="GPU synchronization point"
op GpuKernelFuse: opcode=GPU_KERNEL_FUSE, value=0x8023, operands=2, result=void, traits=IsFusible, interfaces=GPU, description="Fuse GPU kernels"
op GpuAnnotateDevice: opcode=GPU_ANNOTATE_DEVICE, value=0x8024, operands=1, result=void, traits=HasNoSideEffects, interfaces=GPU, description="Annotate GPU device type"

# ============================================================================
# SECTION 8: CONCURRENCY OPERATIONS
# ============================================================================

[operations:concurrency]

op AsyncSpawn: opcode=ASYNC_SPAWN, value=0x1A4, operands=1, result=I64, traits=IsAsyncSpawnable, interfaces=Concurrency, description="Spawn async task"
op AsyncAwait: opcode=ASYNC_AWAIT, value=0x1A5, operands=1, result=I64, traits=, interfaces=Concurrency, description="Await async result"
op FiberYield: opcode=FIBER_YIELD, value=0x1A6, operands=0, result=void, traits=, interfaces=Concurrency, description="Yield from fiber"
op BarrierSync: opcode=BARRIER_SYNC, value=0x1A7, operands=0, result=void, traits=, interfaces=Concurrency, description="Synchronization barrier"
op ChanSend: opcode=CHAN_SEND, value=0x1A8, operands=2, result=void, traits=, interfaces=Concurrency, description="Send on channel"
op ChanRecv: opcode=CHAN_RECV, value=0x1A9, operands=1, result=I64, traits=, interfaces=Concurrency, description="Receive from channel"
op LockAcquire: opcode=LOCK_ACQUIRE, value=0x1AA, operands=1, result=void, traits=, interfaces=Concurrency, description="Lock acquisition"
op LockRelease: opcode=LOCK_RELEASE, value=0x1AB, operands=1, result=void, traits=, interfaces=Concurrency, description="Lock release"
op MemoryFence: opcode=MEMORY_FENCE, value=0x1AC, operands=0, result=void, traits=IsMemoryOp, interfaces=Concurrency|Memory, description="Memory fence"
op ThreadSpawn: opcode=THREAD_SPAWN, value=0x1AD, operands=1, result=I64, traits=IsAsyncSpawnable, interfaces=Concurrency, description="Spawn OS thread"
op WasmInvoke: opcode=WASM_INVOKE, value=0x410, operands=2, result=I64, traits=IsSpeculative, interfaces=ControlFlow, description="WebAssembly indirect table call"
op FiberYieldToLoop: opcode=FIBER_YIELD_LOOP, value=0x411, operands=0, result=void, traits=IsAsyncSpawnable, interfaces=Concurrency, description="Yield execution back to async Event Loop"
op SuspendContext: opcode=SUSPEND_CTX, value=0x412, operands=0, result=I64, traits=HasNoSideEffects, interfaces=Concurrency, description="Capture continuation context (Coroutine)"
op ResumeContext: opcode=RESUME_CTX, value=0x413, operands=1, result=void, traits=IsTerminator, interfaces=Concurrency|ControlFlow, description="Resume continuation context"
op ARMNeonAdd: opcode=NEON_VADD_Q, value=0x414, operands=2, result=VectorI32x16, traits=IsHardwareIntrinsic, interfaces=SIMD, description="ARM NEON mobile-optimized 128-bit vector add"

# ============================================================================
# SECTION 9: DATA STRUCTURE OPERATIONS
# ============================================================================

[operations:dsa]

op GraphBuild: opcode=GRAPH_BUILD, value=0x1B8, operands=2, result=I64, traits=, interfaces=DSA, description="Construct graph from edges"
op GraphTraverse: opcode=GRAPH_TRAVERSE, value=0x1B9, operands=1, result=I64, traits=, interfaces=DSA, description="Traverse graph (DFS/BFS)"
op TreeBuild: opcode=TREE_BUILD, value=0x1BA, operands=2, result=I64, traits=, interfaces=DSA, description="Construct tree structure"
op TreeTraverse: opcode=TREE_TRAVERSE, value=0x1BB, operands=1, result=I64, traits=, interfaces=DSA, description="Traverse tree"
op TrieBuild: opcode=TRIE_BUILD, value=0x1BC, operands=2, result=I64, traits=, interfaces=DSA, description="Build trie (prefix tree)"
op TrieLookup: opcode=TRIE_LOOKUP, value=0x1BD, operands=2, result=I64, traits=IsMemoryRead, interfaces=DSA, description="Trie key lookup"
op TrieInsert: opcode=TRIE_INSERT, value=0x1BE, operands=2, result=void, traits=IsMemoryWrite, interfaces=DSA, description="Insert into trie"
op DsaAllocate: opcode=DSA_ALLOCATE, value=0x1BF, operands=1, result=I64, traits=, interfaces=DSA, description="Allocate DSA node"
op DsaDeallocate: opcode=DSA_DEALLOCATE, value=0x1C0, operands=1, result=void, traits=, interfaces=DSA, description="Deallocate DSA node"
op ScopAnalyze: opcode=SCOP_ANALYZE, value=0x1C1, operands=1, result=I64, traits=HasNoSideEffects, interfaces=DSA, description="Analyze polyhedral loop structure"

# ============================================================================
# SECTION 10: TENSOR/ML OPERATIONS
# ============================================================================

[operations:tensor]

op TensorReshape: opcode=TENSOR_RESHAPE, value=0x1CC, operands=2, result=TensorI64, traits=HasNoSideEffects, interfaces=Tensor, description="Reshape tensor dimensions"
op TensorReduce: opcode=TENSOR_REDUCE, value=0x1CD, operands=2, result=F64, traits=HasNoSideEffects, interfaces=Tensor|Arithmetic, description="Reduce tensor (sum, max, etc)"
op TensorTranspose: opcode=TENSOR_TRANSPOSE, value=0x1CE, operands=2, result=TensorI64, traits=HasNoSideEffects, interfaces=Tensor, description="Transpose/permute dimensions"
op TensorSlice: opcode=TENSOR_SLICE, value=0x1CF, operands=3, result=TensorI64, traits=HasNoSideEffects, interfaces=Tensor, description="Extract tensor slice"
op TensorConcat: opcode=TENSOR_CONCAT, value=0x1D0, operands=2, result=TensorI64, traits=HasNoSideEffects, interfaces=Tensor, description="Concatenate tensors"
op TensorBroadcast: opcode=TENSOR_BROADCAST, value=0x1D1, operands=2, result=TensorI64, traits=HasNoSideEffects, interfaces=Tensor, description="Broadcast to shape"
op TensorGemm: opcode=TENSOR_GEMM, value=0x1D2, operands=3, result=TensorI64, traits=, interfaces=Tensor|Arithmetic, description="General matrix multiplication"
op TensorConv: opcode=TENSOR_CONV, value=0x1D3, operands=3, result=TensorI64, traits=, interfaces=Tensor|Arithmetic, description="Convolution operation"
op TensorPool: opcode=TENSOR_POOL, value=0x1D4, operands=2, result=TensorI64, traits=HasNoSideEffects, interfaces=Tensor, description="Pooling operation"
op TensorSoftmax: opcode=TENSOR_SOFTMAX, value=0x1D5, operands=1, result=TensorI64, traits=, interfaces=Tensor|Arithmetic, description="Softmax normalization"

# ML-specific
op TensorRelu: opcode=TENSOR_RELU, value=0x8030, operands=1, result=TensorI64, traits=HasNoSideEffects, interfaces=Tensor|Arithmetic, description="ReLU activation"
op TensorBatchnorm: opcode=TENSOR_BATCHNORM, value=0x8031, operands=3, result=TensorI64, traits=HasNoSideEffects, interfaces=Tensor|Arithmetic, description="Batch normalization"
op TensorGather: opcode=TENSOR_GATHER, value=0x8032, operands=2, result=TensorI64, traits=IsMemoryRead, interfaces=Tensor|Memory, description="Tensor gather"
op TensorScatterD: opcode=TENSOR_SCATTER_D, value=0x8033, operands=3, result=void, traits=IsMemoryWrite, interfaces=Tensor|Memory, description="Tensor scatter"

# ============================================================================
# SECTION 11: CUSTOM DIALECT OPERATIONS (FROM PRESERVED DIALECTS)
# ============================================================================

[operations:custom]

# IR_Dialect_Interface.hpp opcodes (0x8001-0x8102)
op DgtlFastAdd: opcode=DGTL_FAST_ADD, value=0x8001, operands=2, result=I64, traits=Commutative|HasNoSideEffects, interfaces=Arithmetic, description="DGTL-specific fast add"
op DgtlFastFma: opcode=DGTL_FAST_FMA, value=0x8002, operands=3, result=F64, traits=HasNoSideEffects, interfaces=Arithmetic, description="DGTL-specific fast FMA"
op CppTemplateSpec: opcode=CPP_TEMPLATE_SPEC, value=0x8101, operands=1, result=I64, traits=HasNoSideEffects, interfaces=, description="C++ template specialization", verifier="verify_cpp_template_specialization"
op RustBorrowMut: opcode=RUST_BORROW_MUT, value=0x8102, operands=1, result=I64, traits=, interfaces=Ownership, description="Rust mutable borrow", verifier="verify_rust_borrow_mut"

# ============================================================================
# SECTION 9: PHASE D OPERATIONS (Variadic & Multi-Result)
# ============================================================================

[operations:core]

# ---- Phase D: Variadic Control Flow & Structure ----
op PhiMulti: opcode=PHI_MULTI, value=0x200, operands=variadic, result=I64, traits=HasNoSideEffects, interfaces=ControlFlow, description="N-ary phi node for SSA merge points", attributes="Variadic", verifier="verify_phi_multi_operand_count"
op TuplePack: opcode=TUPLE_PACK, value=0x201, operands=variadic, results=variadic, traits=HasNoSideEffects, interfaces=, description="Pack multiple values into tuple structure", attributes="Variadic"
op TupleUnpack: opcode=TUPLE_UNPACK, value=0x202, operands=1, results=variadic, traits=HasNoSideEffects, interfaces=, description="Extract fields from tuple into separate values", attributes="MultiResult"
op SelectMulti: opcode=SELECT_MULTI, value=0x203, operands=variadic, result=I64, traits=HasNoSideEffects, interfaces=ControlFlow, description="N-way mux: select from array of values based on condition", attributes="Variadic", verifier="verify_select_multi_operands"
op CallVariadic: opcode=CALL_VARIADIC, value=0x204, operands=variadic, result=I64, traits=IsSpeculative, interfaces=ControlFlow, description="Variadic function call with arbitrary number of arguments", attributes="Variadic"
op SwitchDispatch: opcode=SWITCH_DISPATCH, value=0x205, operands=2, result=void, traits=IsTerminator, interfaces=ControlFlow|Terminator, description="Jump table switch on value"

# ---- Phase D: Memory & Concurrency Safety ----
op VolatileLoad: opcode=VOLATILE_LOAD, value=0x206, operands=1, result=I64, traits=IsMemoryRead, interfaces=Memory, attributes="Acquire", description="Volatile memory read (prevents optimization)"
op VolatileStore: opcode=VOLATILE_STORE, value=0x207, operands=2, result=void, traits=IsMemoryWrite, interfaces=Memory, attributes="Release", description="Volatile memory write (prevents optimization)"
op AcquireFence: opcode=ACQUIRE_FENCE, value=0x208, operands=0, result=void, traits=IsMemoryOp, interfaces=Memory|Concurrency, attributes="Acquire", description="Acquire synchronization fence"
op ReleaseFence: opcode=RELEASE_FENCE, value=0x209, operands=0, result=void, traits=IsMemoryOp, interfaces=Memory|Concurrency, attributes="Release", description="Release synchronization fence"

# Pattern_Rewriter analysis-invalidation hooks
# (Note: Analysis invalidation is metadata-only, handled by PassManager traits)

# Pattern rewriting infrastructure:
#   - MutationKind: Replace | Erase
#   - AnalysisInvalidation: DominatorTree | LoopInfo | Liveness | AliasAnalysis | MemoryDependence | ValueNumbering | All
#   - This is handled by Pass traits and rewrite summaries (not IR ops themselves)

# ============================================================================
# SECTION 12: HFT OPERATIONS
# ============================================================================

[operations:hft]

op ReadTSC: opcode=READ_TSC, value=0x600, operands=0, result=I64, traits=IsLatencyCritical|IsHardwareIntrinsic, interfaces=Memory, description="Read Time Stamp Counter (RDTSC) for nanosecond timing"
op BranchLikely: opcode=BRANCH_LIKELY, value=0x601, operands=3, result=void, traits=IsTerminator|IsLatencyCritical, interfaces=ControlFlow|Terminator, attributes=HotPath, description="Conditional branch with hardware predict-taken hint"
op BranchUnlikely: opcode=BRANCH_UNLIKELY, value=0x602, operands=3, result=void, traits=IsTerminator|IsLatencyCritical, interfaces=ControlFlow|Terminator, attributes=ColdPath, description="Conditional branch with hardware predict-not-taken hint"
op CacheLineFlush: opcode=CLFLUSH, value=0x603, operands=1, result=void, traits=IsLatencyCritical|IsHardwareIntrinsic, interfaces=Memory, description="Flush cache line to main memory (CLFLUSH)"
op CacheLinePrefetch: opcode=PREFETCH_T0, value=0x604, operands=1, result=void, traits=IsLatencyCritical|IsHardwareIntrinsic, interfaces=Memory, description="Prefetch data to L1 cache"
op SpinLockAcquire: opcode=SPIN_ACQUIRE, value=0x605, operands=1, result=void, traits=IsLatencyCritical, interfaces=Concurrency, description="Zero-syscall hardware spinlock"
op RingBufferPushFree: opcode=RING_PUSH_FREE, value=0x606, operands=2, result=Bool, traits=IsLatencyCritical, interfaces=DSA, attributes=LockFree, description="Lock-free SPSC ring buffer insertion"

# ============================================================================
# SECTION 13: AI & NEURAL NETWORK OPERATIONS
# ============================================================================

[operations:ai]

op MatMulBF16: opcode=MATMUL_BF16, value=0x480, operands=3, result=TensorBF16, traits=IsHardwareIntrinsic, interfaces=NeuralNet|Tensor, description="BFloat16 Matrix Multiplication (Tensor Cores/AMX)"
op MatMulFP8: opcode=MATMUL_FP8, value=0x481, operands=3, result=TensorFP8, traits=IsHardwareIntrinsic, interfaces=NeuralNet|Tensor, description="FP8 Matrix Multiplication"
op ScaledDotProductAttn: opcode=SDPA_F16, value=0x482, operands=4, result=TensorBF16, traits=IsHardwareIntrinsic, interfaces=NeuralNet|Tensor, description="Flash Attention primitive (Q, K, V, Mask)"
op SoftmaxFast: opcode=SOFTMAX_FAST, value=0x483, operands=1, result=TensorBF16, traits=HasNoSideEffects, interfaces=NeuralNet|Tensor, description="Hardware-accelerated Softmax"
op LayerNorm: opcode=LAYER_NORM, value=0x484, operands=3, result=TensorBF16, traits=HasNoSideEffects, interfaces=NeuralNet|Tensor, description="Layer Normalization"
op RoPE: opcode=ROPE_EMBED, value=0x485, operands=2, result=TensorBF16, traits=HasNoSideEffects, interfaces=NeuralNet|Tensor, description="Rotary Positional Embedding"

# ============================================================================
# SECTION 14: GAME ENGINE & SPATIAL MATH OPERATIONS
# ============================================================================

[operations:game]

op FastInvSqrt: opcode=FAST_INV_SQRT, value=0x700, operands=1, result=F32, traits=HasNoSideEffects|IsHardwareIntrinsic, interfaces=SpatialMath, attributes=FastMath, description="Quake-style Fast Inverse Square Root (rsqrtss)"
op Vec3Cross: opcode=VEC3_CROSS, value=0x701, operands=2, result=Vec3xF32, traits=HasNoSideEffects, interfaces=SpatialMath|SIMD, description="3D Vector Cross Product"
op Vec4Dot: opcode=VEC4_DOT, value=0x702, operands=2, result=F32, traits=HasNoSideEffects|IsHardwareIntrinsic, interfaces=SpatialMath|SIMD, description="4D Vector Dot Product (DPPS)"
op Mat4x4Mul: opcode=MAT4_MUL, value=0x703, operands=2, result=Mat4x4F32, traits=HasNoSideEffects, interfaces=SpatialMath|SIMD, description="4x4 Matrix Multiplication for 3D Transforms"
op QuatSlerp: opcode=QUAT_SLERP, value=0x704, operands=3, result=QuatF32, traits=HasNoSideEffects, interfaces=SpatialMath|SIMD, description="Quaternion Spherical Linear Interpolation"
op RayAABBIntersect: opcode=RAY_AABB_ISECT, value=0x705, operands=2, result=Bool, traits=HasNoSideEffects, interfaces=SpatialMath, description="Ray vs Axis-Aligned Bounding Box Intersection"
# ============================================================================
# SECTION 15: CANONICAL I64 BITWISE OPERATIONS
# ============================================================================
# These operations preserve the complete pre-existing semantic surface as first-
# class canonical DGTL operations. They are not fallback/aliasing paths.
[operations:core]
op AndI64: opcode=AND_I64, value=0x41, operands=2, result=I64, traits=Commutative|HasNoSideEffects|ConstantFoldable|Associative, interfaces=BitwiseOp, description="64-bit integer bitwise AND"
op OrI64: opcode=OR_I64, value=0x42, operands=2, result=I64, traits=Commutative|HasNoSideEffects|ConstantFoldable|Associative, interfaces=BitwiseOp, description="64-bit integer bitwise OR"
op XorI64: opcode=XOR_I64, value=0x43, operands=2, result=I64, traits=Commutative|HasNoSideEffects|ConstantFoldable|Associative, interfaces=BitwiseOp, description="64-bit integer bitwise XOR"
op ShlI64: opcode=SHL_I64, value=0x44, operands=2, result=I64, traits=HasNoSideEffects|ConstantFoldable, interfaces=BitwiseOp, description="64-bit integer logical left shift"
op ShrI64: opcode=SHR_I64, value=0x45, operands=2, result=I64, traits=HasNoSideEffects|ConstantFoldable, interfaces=BitwiseOp, description="64-bit integer logical right shift"

# ============================================================================
# SECTION 16: CANONICAL NAME ALIASES
# ============================================================================
# Aliases are source-level spellings for canonical operation identities. They
# never introduce a second semantic implementation or verification path.
[aliases]
alias MOV = REG_MOVE
alias CONST = LOAD_IMM
alias OP_ADD = ADD_I32
alias RETURN = RET
alias ASYNC_LAUNCH = ASYNC_SPAWN
alias SYNC_BARRIER = BARRIER_SYNC




