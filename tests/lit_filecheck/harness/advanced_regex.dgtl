; RUN: dgtl-opt --pass=inlining --filecheck %s
; FileCheck test with advanced regex patterns
; Validates that complex patterns and case-insensitive hex match correctly

op 0x0A 0x00000001 0x00000000 0x00000000 0x00000000 0x0000
op 0x0B 0x00000002 0x00000001 0x00000001 0x00000000 0x0001
op 0x0C 0x00000003 0x00000002 0x00000002 0x00000000 0x0002
op 0x0D 0x00000004 0x00000003 0x00000003 0x00000000 0x00FF

; CHECK: DGTL IR Text Format
; CHECK: Stream size: 4 nodes
; CHECK-DAG: op 0x0a 0x00000001
; CHECK-DAG: op 0x0b 0x00000002
; CHECK-DAG: op 0x0c 0x00000003
; CHECK-DAG: op 0x0d 0x00000004
; CHECK-NOT: exception
; CHECK-NOT: error
; CHECK: End of IR
