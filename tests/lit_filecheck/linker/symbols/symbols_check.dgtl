; RUN: %dgtl-llc --target=x86_64 --output=%t.s %s
; RUN: dgtl-opt --pass=inlining --filecheck %s
; FileCheck test for Symbol Export and External Linkage
; Verifies kernel entry symbols and global visibility

op 0x0D 0x00000001 0x0000007B 0x00000000 0x00000000 0x0000
op 0x65 0x00000000 0x00000001 0x00000000 0x00000000 0x0000

; CHECK: DGTL IR Text Format
; CHECK: Stream size: 2 nodes
; CHECK: op 0x0d 0x00000001
; CHECK: op 0x65 0x00000000
; CHECK: End of IR
