; RUN: dgtl-opt --pass=inlining --filecheck %s
; FileCheck test for Control Flow and Branch Operations
; Verifies LABEL, BRANCH_COND, GOTO, and RET

op 0x62 0x00000001 0x00000000 0x00000000 0x00000000 0x0000
op 0x0D 0x00000002 0x00000001 0x00000000 0x00000000 0x0000
op 0x66 0x00000003 0x00000002 0x00000002 0x00000000 0x0000
op 0x62 0x00000002 0x00000000 0x00000000 0x00000000 0x0000
op 0x65 0x00000000 0x00000002 0x00000000 0x00000000 0x0000

; CHECK: DGTL IR Text Format
; CHECK: op 0x62 0x00000001
; CHECK: op 0x66 0x00000003
; CHECK: op 0x62 0x00000002
; CHECK: op 0x65 0x00000000
; CHECK: End of IR
