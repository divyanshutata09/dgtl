; RUN: %dgtl-llc --target=x86_64 --output=%t.s %s
; RUN: dgtl-opt --pass=inlining --filecheck %s
; FileCheck test for While Loop Lowering and Control Flow Graph Construction
; Verifies loop preheader, loop header comparison, conditional branch, loop body, backedge, and exit

; Block 0: Loop Preheader (initialization: i = 0, sum = 0, limit = 10, step = 1)
op 0x0D 0x00000001 0x00000000 0x00000000 0x00000000 0x0000
op 0x0D 0x00000002 0x00000000 0x00000000 0x00000000 0x0000
op 0x0D 0x00000003 0x0000000A 0x00000000 0x00000000 0x0000
op 0x0D 0x00000004 0x00000001 0x00000000 0x00000000 0x0000
op 0x63 0x00000000 0x00000064 0x00000000 0x00000000 0x0001

; Block 1: Loop Condition Header (while i < 10)
op 0x62 0x00000064 0x00000000 0x00000000 0x00000000 0x0000
op 0x2A 0x00000005 0x00000001 0x00000003 0x00000000 0x0000
op 0x66 0x00000000 0x00000005 0x00000066 0x00000000 0x0001
op 0x63 0x00000000 0x00000065 0x00000000 0x00000000 0x0001

; Block 2: Loop Body (sum = sum + i; i = i + 1; goto loop_header)
op 0x62 0x00000066 0x00000000 0x00000000 0x00000000 0x0000
op 0x14 0x00000006 0x00000002 0x00000001 0x00000000 0x0000
op 0x0C 0x00000002 0x00000006 0x00000000 0x00000000 0x0000
op 0x14 0x00000007 0x00000001 0x00000004 0x00000000 0x0000
op 0x0C 0x00000001 0x00000007 0x00000000 0x00000000 0x0000
op 0x63 0x00000000 0x00000064 0x00000000 0x00000000 0x0001

; Block 3: Loop Exit (return sum)
op 0x62 0x00000065 0x00000000 0x00000000 0x00000000 0x0000
op 0x65 0x00000000 0x00000002 0x00000000 0x00000000 0x0000

; CHECK: DGTL IR Text Format
; CHECK: Stream size: 17 nodes
; CHECK: op 0x63 0x00000000 0x00000064
; CHECK: op 0x62 0x00000064
; CHECK: op 0x2a 0x00000005 0x00000001 0x00000003
; CHECK: op 0x66 0x00000000 0x00000005 0x00000066
; CHECK: op 0x62 0x00000066
; CHECK: op 0x14 0x00000006
; CHECK: op 0x14 0x00000007
; CHECK: op 0x63 0x00000000 0x00000064
; CHECK: op 0x62 0x00000065
; CHECK: op 0x65 0x00000000 0x00000002
; CHECK: End of IR
