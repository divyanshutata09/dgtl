; RUN: dgtl-opt --pass=inlining --filecheck %s
; FileCheck test for Subroutine and System Call Invocations
; Verifies CALL, SYSCALL, and RET operations

op 0x0D 0x00000001 0x0000002A 0x00000000 0x00000000 0x0000
op 0x6E 0x00000002 0x00000001 0x00000000 0x00000000 0x0000
op 0x6F 0x00000003 0x00000002 0x00000000 0x00000000 0x0000
op 0x65 0x00000000 0x00000003 0x00000000 0x00000000 0x0000

; CHECK: DGTL IR Text Format
; CHECK: op 0x6e 0x00000002
; CHECK: op 0x6f 0x00000003
; CHECK: op 0x65 0x00000000
; CHECK: End of IR
