; RUN: dgtl-opt --pass=inlining --filecheck %s
; FileCheck test for Bitwise Logical Operations
; Verifies SHL_I32, AND_I32, OR_I32, XOR_I32, SHR_I32

op 0x0D 0x00000001 0x000000FF 0x00000000 0x00000000 0x0000
op 0x0D 0x00000002 0x00000004 0x00000000 0x00000000 0x0000
op 0x18 0x00000003 0x00000001 0x00000002 0x00000000 0x0000
op 0x19 0x00000004 0x00000001 0x00000002 0x00000000 0x0000
op 0x1A 0x00000005 0x00000001 0x00000002 0x00000000 0x0000
op 0x1B 0x00000006 0x00000001 0x00000002 0x00000000 0x0000
op 0x1D 0x00000007 0x00000001 0x00000002 0x00000000 0x0000
op 0x0B 0x00000008 0x00000003 0x00000000 0x00000000 0x0000

; CHECK: DGTL IR Text Format
; CHECK: op 0x18 0x00000003
; CHECK: op 0x19 0x00000004
; CHECK: op 0x1a 0x00000005
; CHECK: op 0x1b 0x00000006
; CHECK: op 0x1d 0x00000007
; CHECK: End of IR
