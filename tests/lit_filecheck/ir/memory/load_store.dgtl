; RUN: dgtl-opt --pass=inlining --filecheck %s
; FileCheck test for Core Memory and Address Operations
; Verifies LOAD, STORE, LOAD_IMM, REG_MOVE, and LEA

op 0x0D 0x00000001 0x00001000 0x00000000 0x00000000 0x0000
op 0x0E 0x00000002 0x00000001 0x00000020 0x00000000 0x0000
op 0x0A 0x00000003 0x00000002 0x00000000 0x00000000 0x0000
op 0x0C 0x00000004 0x00000003 0x00000000 0x00000000 0x0000
op 0x0B 0x00000005 0x00000004 0x00000002 0x00000000 0x0000

; CHECK: DGTL IR Text Format
; CHECK: op 0x0d 0x00000001
; CHECK: op 0x0e 0x00000002
; CHECK: op 0x0a 0x00000003
; CHECK: op 0x0c 0x00000004
; CHECK: op 0x0b 0x00000005
; CHECK: End of IR
