; RUN: dgtl-opt --pass=inlining --filecheck %s
; FileCheck test for 64-bit Integer Arithmetic Operations
; Verifies ADD_I64, SUB_I64, MUL_I64, DIV_I64, MOD_I64

op 0x0D 0x00000001 0x00000100 0x00000000 0x00000000 0x0000
op 0x0D 0x00000002 0x00000010 0x00000000 0x00000000 0x0000
op 0x3C 0x00000003 0x00000001 0x00000002 0x00000000 0x0000
op 0x3D 0x00000004 0x00000001 0x00000002 0x00000000 0x0000
op 0x3E 0x00000005 0x00000001 0x00000002 0x00000000 0x0000
op 0x3F 0x00000006 0x00000001 0x00000002 0x00000000 0x0000
op 0x40 0x00000007 0x00000001 0x00000002 0x00000000 0x0000
op 0x0B 0x00000008 0x00000003 0x00000000 0x00000000 0x0000

; CHECK: DGTL IR Text Format
; CHECK: op 0x3c 0x00000003
; CHECK: op 0x3d 0x00000004
; CHECK: op 0x3e 0x00000005
; CHECK: op 0x3f 0x00000006
; CHECK: op 0x40 0x00000007
; CHECK: End of IR
