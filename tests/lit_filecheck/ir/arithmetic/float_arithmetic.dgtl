; RUN: dgtl-opt --pass=inlining --filecheck %s
; FileCheck test for Single and Double Precision Floating Point Arithmetic
; Verifies ADD_F32, SUB_F32, MUL_F32, DIV_F32, FMA_F32, ADD_F64

op 0x0D 0x00000001 0x3F800000 0x00000000 0x00000000 0x0000
op 0x0D 0x00000002 0x40000000 0x00000000 0x00000000 0x0000
op 0x1E 0x00000003 0x00000001 0x00000002 0x00000000 0x0000
op 0x1F 0x00000004 0x00000001 0x00000002 0x00000000 0x0000
op 0x20 0x00000005 0x00000001 0x00000002 0x00000000 0x0000
op 0x21 0x00000006 0x00000001 0x00000002 0x00000000 0x0000
op 0x23 0x00000007 0x00000001 0x00000002 0x00000003 0x0000
op 0x46 0x00000008 0x00000001 0x00000002 0x00000000 0x0000
op 0x0B 0x00000009 0x00000007 0x00000000 0x00000000 0x0000

; CHECK: DGTL IR Text Format
; CHECK: op 0x1e 0x00000003
; CHECK: op 0x1f 0x00000004
; CHECK: op 0x20 0x00000005
; CHECK: op 0x21 0x00000006
; CHECK: op 0x23 0x00000007
; CHECK: op 0x46 0x00000008
; CHECK: End of IR
