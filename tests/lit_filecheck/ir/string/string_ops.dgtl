; RUN: dgtl-opt --pass=inlining --filecheck %s
; FileCheck test for High-Level String Operations
; Verifies STRING_CONST, STRING_LENGTH, STRING_COMPARE, and STRING_CONCAT

op 0x54 0x00000001 0x00000000 0x00000000 0x00000000 0x0000
op 0x54 0x00000002 0x00000000 0x00000000 0x00000000 0x0000
op 0x55 0x00000003 0x00000001 0x00000000 0x00000000 0x0000
op 0x56 0x00000004 0x00000001 0x00000002 0x00000000 0x0000
op 0x57 0x00000005 0x00000001 0x00000002 0x00000000 0x0000

; CHECK: DGTL IR Text Format
; CHECK: op 0x54 0x00000001
; CHECK: op 0x54 0x00000002
; CHECK: op 0x55 0x00000003
; CHECK: op 0x56 0x00000004
; CHECK: op 0x57 0x00000005
; CHECK: End of IR
