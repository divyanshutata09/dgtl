; RUN: dgtl-opt --pass=dce --filecheck %s
; FileCheck test for Dead Code Elimination (DCE) pass
; Tests removal of unreachable and unused operations

; Sample IR: Mix of live and dead code
; Operations with result IDs 1-3 (live), operation with result ID 4 (dead - never read)
op 0x02 0x00000001 0x00000000 0x00000000 0x00000000 0x0000
op 0x03 0x00000002 0x00000001 0x00000001 0x00000000 0x0000
op 0x04 0x00000003 0x00000002 0x00000002 0x00000000 0x0000
op 0x05 0x00000004 0x00000000 0x00000000 0x00000000 0x0000

; CHECK-LABEL: Stream size
; CHECK: op 0x
; CHECK: 0x00000001
; CHECK: 0x00000002
; CHECK: 0x00000003
; CHECK-NOT: FAILED
; CHECK-NOT: exception
