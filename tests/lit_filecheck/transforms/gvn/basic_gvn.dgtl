; RUN: dgtl-opt --pass=gvn --filecheck %s
; FileCheck test for Global Value Numbering (GVN) pass
; Verifies that GVN identifies and replaces redundant operations with register moves

op 0x0D 0x00000001 0x00000005 0x00000000 0x00000000 0x0000
op 0x0D 0x00000002 0x0000000A 0x00000000 0x00000000 0x0000
op 0x14 0x00000003 0x00000001 0x00000002 0x00000000 0x0000
op 0x14 0x00000004 0x00000001 0x00000002 0x00000000 0x0000

; CHECK: DGTL IR Text Format
; CHECK: op 0x0d 0x00000001
; CHECK: op 0x0d 0x00000002
; CHECK: op 0x14 0x00000003
; CHECK: op 0x0c 0x00000004 0x00000003
; CHECK-NOT: op 0x14 0x00000004
; CHECK: End of IR
