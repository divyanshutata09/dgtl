; RUN: dgtl-opt --pass=dce --filecheck %s
; FileCheck test for Dead Code Elimination (DCE) pass
; Verifies that DCE removes unused arithmetic operations while preserving memory effects

op 0x0A 0x00000001 0x00000000 0x00000000 0x00000000 0x0000
op 0x14 0x00000002 0x00000001 0x00000001 0x00000000 0x0000
op 0x15 0x00000003 0x00000002 0x00000001 0x00000000 0x0000
op 0x0B 0x00000004 0x00000001 0x00000000 0x00000000 0x0000

; CHECK: DGTL IR Text Format
; CHECK: op 0x0a 0x00000001
; CHECK: op 0x0b 0x00000004
; CHECK-NOT: op 0x14
; CHECK-NOT: op 0x15
; CHECK: End of IR
