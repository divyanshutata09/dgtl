form gather_16: opcode=GATHER_16, machine_form=Call
form gep: opcode=GEP, machine_form=Call
form gpu_launch: opcode=GPU_LAUNCH, machine_form=Call
form graph_build: opcode=GRAPH_BUILD, machine_form=Call
form graph_traverse: opcode=GRAPH_TRAVERSE, machine_form=Call
form guard_alias: opcode=GUARD_ALIAS, machine_form=Call
form guard_value: opcode=GUARD_VALUE, machine_form=Call
form immediate: opcode=IMMEDIATE, machine_form=LoadImmediate
form lea: opcode=LEA, machine_form=Call
form lock_acquire: opcode=LOCK_ACQUIRE, machine_form=Call
form lock_release: opcode=LOCK_RELEASE, machine_form=Call
