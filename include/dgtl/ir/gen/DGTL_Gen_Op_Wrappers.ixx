template <typename Op>
[[nodiscard]] constexpr bool validate_op_type() noexcept {
    return !Op::kName.empty() &&
           !Op::kDialect.empty() &&
           !Op::kResultType.empty() &&
           !Op::kDescription.empty() &&
           (Op::kOperandsCount >= -1) &&
           ((Op::kIsVariadicOperands ? 1 : 0) >= 0) &&
           ((Op::kIsVariadicResults ? 1 : 0) >= 0) &&
           (Op::kTraitBits >= 0ULL) &&
           (Op::kInterfaceBits >= 0ULL) &&
           (Op::kAttributeBits >= 0ULL);
}

template <typename... Ops>
[[nodiscard]] constexpr bool validate_all_op_types() noexcept {
    return (validate_op_type<Ops>() && ...);
}

static_assert(validate_all_op_types<
    NopOp,
    UndefOp,
    LoadOp,
    StoreOp,
    AtomicLoadOp,
    AtomicStoreOp,
    AtomicFenceOp,
    PtrCastOp,
    PtrDiffOp,
    GetElementPtrOp,
    PtrToIntOp,
    IntToPtrOp,
    BoolSelectOp,
    RegMoveOp,
    LoadImmOp,
    LeaOp,
    PrefetchOp,
    ImmediateOp,
    StringConstOp,
    StringLengthOp,
    StringCompareOp,
    StringConcatOp,
    StringSubstringOp,
    AddI8Op,
    AddI32Op,
    SubI32Op,
    MulI32Op,
    DivI32Op,
    ShlI32Op,
    AndI32Op,
    OrI32Op,
    XorI32Op,
    ModI32Op,
    ShrI32Op,
    AddI64Op,
    SubI64Op,
    MulI64Op,
    DivI64Op,
    ModI64Op,
    AddI128Op,
    AddI256Op,
    AddF8Op,
    AddBF16Op,
    AddF32Op,
    SubF32Op,
    MulF32Op,
    DivF32Op,
    FmaF32Op,
    FmaWidenF16F32Op,
    AddF64Op,
    SubF64Op,
    MulF64Op,
    DivF64Op,
    CmpEqI32Op,
    CmpNeI32Op,
    CmpLtI32Op,
    CmpLeI32Op,
    CmpGtI32Op,
    CmpGeI32Op,
    BitFieldInsertOp,
    BitFieldExtractOp,
    LabelOp,
    GotoOp,
    BranchOp,
    BranchCondOp,
    BranchCompareFusedOp,
    CallOp,
    SyscallOp,
    GuardAliasOp,
    ReturnOp,
    PhiNodeOp,
    SelectOp,
    GuardValueOp,
    DeoptTriggerOp,
    AssumeOp,
    RegionBeginOp,
    RegionEndOp,
    FusionGroupOp,
    GatherF32x512Op,
    Gather16Op,
    StoreV512Op,
    VecAddF32x512Op,
    VecMulF32x512Op,
    SimdBslPredicateOp,
    FcvtlF16ToF32Op,
