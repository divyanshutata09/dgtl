[[nodiscard]] constexpr bool is_memory_form(MachineForm form) noexcept {
    return form == MachineForm::LoadStack || form == MachineForm::StoreStack ||
           form == MachineForm::VectorGather512 || form == MachineForm::VectorStore512 ||
           form == MachineForm::AtomicOp;
}

[[nodiscard]] constexpr bool is_terminator_form(MachineForm form) noexcept {
    return form == MachineForm::Goto || form == MachineForm::BranchCond ||
           form == MachineForm::BranchCompare || form == MachineForm::Return;
}

[[nodiscard]] constexpr bool is_branch_form(MachineForm form) noexcept {
    return form == MachineForm::Goto || form == MachineForm::BranchCond ||
           form == MachineForm::BranchCompare;
}

[[nodiscard]] constexpr bool is_call_form(MachineForm form) noexcept {
    return form == MachineForm::Call;
}

[[nodiscard]] constexpr bool is_atomic_form(MachineForm form) noexcept {
    return form == MachineForm::AtomicOp;
}

[[nodiscard]] constexpr bool is_barrier_form(MachineForm form) noexcept {
    return form == MachineForm::HardwareFence || form == MachineForm::ConcurrentSync;
}

[[nodiscard]] constexpr bool verify_form_contract(
    ir::OpCode opcode, MachineForm form) noexcept {
    if (form == MachineForm::Unhandled) return true;
    if (ir::detail::irnode_is_branch(opcode)) {
        return is_terminator_form(form);
    }
    return true;
}

[[nodiscard]] constexpr bool verify_node_form_compatibility(
    const ir::IRNode& node, MachineForm form) noexcept {
    if (form == MachineForm::Unhandled) return true;
    if (node.is_terminator()) {
        return is_terminator_form(form) || form == MachineForm::Call || form == MachineForm::ConcurrentSync;
    }
    return true;
}

